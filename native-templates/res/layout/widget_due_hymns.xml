<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="#F6EED9"
    android:paddingLeft="10dp"
    android:paddingRight="4dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Yared Hymn Tracker"
            android:textColor="#2B2118"
            android:textSize="12sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <!-- Shows status (playing/paused/segment) when set, otherwise the due count. -->
        <TextView
            android:id="@+id/widget_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#7A2E2E"
            android:textSize="10sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_due_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nothing due"
            android:textColor="#5A4B3A"
            android:textSize="10sp"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

    <Button
        android:id="@+id/widget_mode_prev"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:text="\u23EA"
        android:textSize="12sp"
        android:textColor="#2B2118"
        android:background="@android:color/transparent"
        android:visibility="gone" />

    <Button
        android:id="@+id/widget_prev"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:text="\u23EE"
        android:textSize="12sp"
        android:textColor="#2B2118"
        android:background="@android:color/transparent" />

    <Button
        android:id="@+id/widget_play_pause"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:text="\u25B6"
        android:textSize="14sp"
        android:textColor="#7A2E2E"
        android:background="@android:color/transparent" />

    <Button
        android:id="@+id/widget_next"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:text="\u23ED"
        android:textSize="12sp"
        android:textColor="#2B2118"
        android:background="@android:color/transparent" />

    <Button
        android:id="@+id/widget_mode_next"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:text="\u23E9"
        android:textSize="12sp"
        android:textColor="#2B2118"
        android:background="@android:color/transparent"
        android:visibility="gone" />
</LinearLayout>
