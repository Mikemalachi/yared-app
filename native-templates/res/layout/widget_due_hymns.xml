<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_bg"
    android:paddingLeft="10dp"
    android:paddingRight="10dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/widget_icon"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginRight="10dp"
        android:src="@mipmap/ic_launcher_round"
        android:contentDescription="Open Yared Hymn Tracker" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Yared Hymn Tracker"
            android:textColor="#FFF2CE7C"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:singleLine="true"
            android:ellipsize="end" />

        <!-- Shows status (playing/paused/segment) when set, otherwise the due count. -->
        <TextView
            android:id="@+id/widget_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text=""
            android:textColor="#FFF6EED9"
            android:textSize="11sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_due_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="Nothing due"
            android:textColor="#FFCDBF9F"
            android:textSize="11sp"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

    <Button
        android:id="@+id/widget_mode_prev"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginLeft="4dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:text="⏪"
        android:textSize="11sp"
        android:textColor="#FFF2CE7C"
        android:background="@drawable/widget_mode_btn"
        android:visibility="gone" />

    <Button
        android:id="@+id/widget_prev"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginLeft="4dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:text="⏮"
        android:textSize="13sp"
        android:textColor="#FFF6EED9"
        android:background="@drawable/widget_btn" />

    <Button
        android:id="@+id/widget_play_pause"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginLeft="6dp"
        android:layout_marginRight="6dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:text="▶"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FF231A13"
        android:background="@drawable/widget_play_btn" />

    <Button
        android:id="@+id/widget_next"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:text="⏭"
        android:textSize="13sp"
        android:textColor="#FFF6EED9"
        android:background="@drawable/widget_btn" />

    <Button
        android:id="@+id/widget_mode_next"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginLeft="4dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:text="⏩"
        android:textSize="11sp"
        android:textColor="#FFF2CE7C"
        android:background="@drawable/widget_mode_btn"
        android:visibility="gone" />
</LinearLayout>
